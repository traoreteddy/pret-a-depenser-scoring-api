# ---- Application ----
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | console
WEB_CONCURRENCY=1

# ---- Modèle ----
MODEL_PATH=models/scoring_credit_v1
MODEL_BACKEND=xgb_native   # xgb_native (défaut prod, booster natif) | pyfunc (MLflow, baseline) | onnx
# MODEL_THRESHOLD=0.48     # override optionnel du seuil métier
XGB_NTHREAD=1
WARMUP_ROWS=10

# ---- Base de données (journalisation des prédictions) ----
DB_ENABLED=true
POSTGRES_USER=scoring
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=scoring_prod
DATABASE_URL=postgresql://scoring:changez-moi@localhost:5433/scoring_prod
DB_POOL_MIN=1
DB_POOL_MAX=4
DB_AUTO_MIGRATE=true
READY_REQUIRE_DB=false

# ---- Échantillonnage des logs ----
LOG_SAMPLE_RATE=0.25
LOG_GREY_ZONE=0.05
LOG_QUEUE_MAXSIZE=10000
LOG_BATCH_SIZE=200
LOG_FLUSH_INTERVAL_S=0.5

# ---- Observabilité ----
METRICS_ENABLED=true
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---- Outils (docker-compose) ----
GRAFANA_ADMIN_PASSWORD=changez-moi
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changez-moi
IMAGE=scoring-api:local

# ---- Scripts (données de référence, hors conteneur) ----
P6_DATA_PATH=/Users/DBS_SA/Documents/COURS/Openclassroom/P6/datas/data_final.parquet
P6_MODEL_PATH=/Users/DBS_SA/Documents/COURS/Openclassroom/P6/mlruns/1/models/m-876583d78837477283a8ea1409b48509/artifacts

# ---- Ports hôte (modifiables si déjà utilisés) ----
API_PORT=8000
POSTGRES_HOST_PORT=5433
PGADMIN_PORT=5050
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DASHBOARD_PORT=8501

PREDICT_IN_THREADPOOL=false
