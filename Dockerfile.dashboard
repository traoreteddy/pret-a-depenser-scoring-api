# Dashboard Streamlit (métier + dérive). Image séparée de l'API : dépendances d'analyse.
FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.20 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project --group analysis
COPY src ./src
COPY data ./data
COPY dashboard ./dashboard
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --group analysis
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
