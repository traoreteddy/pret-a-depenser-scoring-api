        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(feature_engineering_duration_seconds_bucket[1m])))",
          "legendFormat": "features p99",
          "refId": "B"
